<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect SDK Permissions -->
    <uses-permission android:name="com.hyundai.pleos.permission.VEHICLE_SPEED" />
    <uses-permission android:name="com.hyundai.pleos.permission.VEHICLE_STEERING" />
    <uses-permission android:name="com.hyundai.pleos.permission.VEHICLE_DYNAMICS" />
    <uses-permission android:name="com.hyundai.pleos.permission.NAVI_HELPER" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Automotive OS Feature Flag -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application
        android:name=".SafeDriveApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SafeDrive"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeDrive">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
